#!/bin/sh
set -e

CONF=/usr/share/nexus/comitup.conf
OLD_DROPIN_DIR=/etc/systemd/system/comitup-web.service.d
STATE=/var/lib/nexus-captive-portal

have_systemd() { [ -d /run/systemd/system ]; }

# Up to 0.1.0, postinst generated a drop-in that bind-mounted our templates
# over comitup's for comitup's own web app. comitup-web now runs nexus-portal
# (packaged drop-in in /usr/lib/systemd/system/comitup-web.service.d/), which
# reads the templates directly.
remove_old_dropin() {
    rm -f "$OLD_DROPIN_DIR/nexus-templates.conf"
    rmdir "$OLD_DROPIN_DIR" 2>/dev/null || true
}

# NetworkManager leaves every interface named in /etc/network/interfaces to
# ifupdown. eth0 stays there (it carries SSH); the wlan0 stanza has to go, or
# comitup never gets the radio. Comment it out rather than delete it.
# Matches nothing once done, so upgrades leave the file alone.
handoff_wlan0() {
    f=/etc/network/interfaces
    [ -f "$f" ] || return 0
    grep -Eq '^[[:space:]]*(iface|auto|allow-[a-z]+)[[:space:]].*\bwlan0\b' "$f" || return 0

    echo "nexus-captive-portal: handing wlan0 from ifupdown to NetworkManager"
    cp "$f" "$f.bak.$(date +%Y%m%d%H%M%S)"
    ifdown wlan0 2>/dev/null || true
    awk '
      /^[[:space:]]*(iface|auto|allow-[a-z]+|mapping|source|rename)[[:space:]]/ { skip = 0 }
      /^[[:space:]]*(auto|allow-[a-z]+)[[:space:]]+wlan0[[:space:]]*$/          { print "# (nexus) " $0; next }
      /^[[:space:]]*iface[[:space:]]+wlan0[[:space:]]/                            { skip = 1 }
      skip { print "# (nexus) " $0; next }
      { print }
    ' "$f" > "$f.nexus"
    mv "$f.nexus" "$f"
    NM_RESTART=1
}

# DietPi manages networking itself (ifupdown + dietpi-config). With Wi-Fi
# "disabled" there, it blacklists cfg80211 — harmless only while the module is
# built into the kernel — and its Wi-Fi monitor would fight NetworkManager.
dietpi_wifi() {
    [ -d /boot/dietpi ] || return 0
    rm -f /etc/modprobe.d/dietpi-disable_wifi.conf
    if have_systemd; then
        systemctl disable --now dietpi-wifi-monitor.service >/dev/null 2>&1 || true
    fi
}

# Restart comitup only when its config actually changed: a restart can take
# the Wi-Fi down briefly, which is unwelcome during an "apt upgrade" over Wi-Fi.
restart_comitup_on_config_change() {
    new=$(sha256sum "$CONF" | cut -d' ' -f1)
    old=$(cat "$STATE/comitup.conf.sha256" 2>/dev/null || true)
    [ "$new" != "$old" ] || return 0
    deb-systemd-invoke restart comitup.service >/dev/null || true
    mkdir -p "$STATE"
    echo "$new" > "$STATE/comitup.conf.sha256"
}

# Boards set up with the old captive-portal/install.sh carry copies elsewhere.
remove_install_sh_leftovers() {
    rm -f /usr/local/sbin/nexus-comitup-callback
    rm -rf /etc/nexus/comitup-templates
}

case "$1" in
    configure)
        NM_RESTART=
        remove_install_sh_leftovers
        handoff_wlan0
        dietpi_wifi
        remove_old_dropin
        if have_systemd; then
            systemctl daemon-reload
            if [ -n "$NM_RESTART" ]; then
                deb-systemd-invoke restart NetworkManager.service >/dev/null || true
            fi
            restart_comitup_on_config_change
        fi
        if command -v iw >/dev/null 2>&1 &&
           ! iw list 2>/dev/null | grep -A10 'Supported interface modes' | grep -q '\* AP$'; then
            echo "nexus-captive-portal: warning: no Wi-Fi device reports AP mode; the hotspot will probably not start." >&2
        fi
        ;;
esac

#DEBHELPER#

# After the debhelper snippets, which create the user nexus-portal (sysusers) the
# portal runs as. comitup-web only runs while the hotspot is up; a restart
# swaps comitup's own web app (0.1.0) for nexus-portal.
if [ "$1" = configure ] && have_systemd; then
    deb-systemd-invoke try-restart comitup-web.service >/dev/null || true
fi

exit 0
