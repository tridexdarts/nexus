# Autodarts board daemon for one user, controlled from the Nexus panel.
# Instance = user name: nexus-autodarts@radxa.service runs radxa's install.
#
# The official installer (autodarts.sh) puts Autodarts into the user's home
# and sets up no service. This unit runs it as a system service with User=,
# so it starts at boot without anyone logging in (a user unit would need
# lingering). It is called nexus-autodarts so it never collides with the
# autodarts.service user unit the app itself can set up.
#
# Not installed yet? Then systemd skips the unit (ConditionPathExists) —
# enabling it before installing Autodarts is harmless.

[Unit]
Description=Autodarts board (%i)
Documentation=https://autodarts.com/downloads
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/%i/.local/bin/autodarts

[Service]
User=%i
# User= also loads the user's supplementary groups, e.g. video for the cameras.
WorkingDirectory=~
ExecStart=/home/%i/.local/bin/autodarts run
Restart=always
RestartSec=5
# `autodarts update` swaps the files in place; give a restart a moment.
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
